# === Banco de dados ===
# Opção A (recomendada p/ dev com docker-compose): string única de conexão.
# Bate com o docker-compose.yml deste diretório (porta 5433 no host para não
# conflitar com um Postgres local na 5432). SSL é desligado automaticamente
# para localhost (ver src/config/database.ts).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/escalas_louvor

# Opção B: variáveis separadas (se você já tem um Postgres local próprio na 5432).
# Usadas apenas quando DATABASE_URL NÃO está definida.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=escalas_louvor

# === App ===
PORT=3000
JWT_SECRET=alguma_string_bem_grande_e_aleatoria
RESEND_API_KEY=
