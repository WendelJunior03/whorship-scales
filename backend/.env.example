# === Banco de dados ===
# DUAS conexões (Passo 4 — isolamento por org com RLS):
#
#  • DATABASE_URL — role ADMIN (superusuário). Usada por migrations e seed, que
#    precisam criar roles/policies e IGNORAR o RLS. Bate com o docker-compose.yml
#    (porta 5433 no host). SSL é desligado automaticamente para localhost.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/escalas_louvor
#
#  • APP_DATABASE_URL — role da APLICAÇÃO (`deepscales_app`, NÃO-superusuário,
#    criado pela migration de RLS). É como o app roda em runtime, sujeito ao RLS.
#    Sem esta variável o app cai para DATABASE_URL e o RLS fica DORMENTE.
#    Em produção (Neon) troque a senha do role e aponte esta URL para ele.
APP_DATABASE_URL=postgres://deepscales_app:deepscales_app_dev@localhost:5433/escalas_louvor

# Opção B: variáveis separadas (se você já tem um Postgres local próprio na 5432).
# Usadas apenas quando DATABASE_URL NÃO está definida.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=escalas_louvor

# === App ===
PORT=3000
JWT_SECRET=alguma_string_bem_grande_e_aleatoria
RESEND_API_KEY=
# URL do front (web) - usada pra montar o link de redefinição de senha no e-mail.
FRONTEND_URL=http://localhost:8081

# Integração Google (módulo 11 — login social + Google Agenda)
# Crie um "OAuth 2.0 Client ID" (tipo Web) no Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Chave para cifrar tokens em repouso (qualquer string longa e aleatória).
APP_ENC_KEY=

# === Billing (Stripe · plano PRO) ===
# Sandbox-first: use as chaves de TESTE (sk_test_… / whsec_…). As de PRODUÇÃO
# (go-live) ficam só no .env do servidor, nunca no git. Sem STRIPE_SECRET_KEY o
# billing fica desligado (endpoints respondem 503) e o app sobe normalmente.
STRIPE_SECRET_KEY=
# Segredo do endpoint de webhook (Dashboard → Developers → Webhooks, ou `stripe listen`).
STRIPE_WEBHOOK_SECRET=
# IDs dos Prices (recurring) do produto PRO — crie um mensal e um anual no Stripe.
STRIPE_PRICE_PRO_MENSAL=
STRIPE_PRICE_PRO_ANUAL=
# Para onde o Stripe volta após o checkout/portal (front). Default: localhost:8081.
BILLING_SUCCESS_URL=http://localhost:8081/assinaturas?checkout=sucesso
BILLING_CANCEL_URL=http://localhost:8081/assinaturas?checkout=cancelado

# === Busca de música — agregador de fontes (Biblioteca) ===
# Deezer + iTunes: gratuitas, sem chave, sempre ligadas.
# GetSongBPM (https://getsongbpm.com/api): cadastro gratuito, exige ativar a chave
# clicando no link que eles mandam por e-mail antes de funcionar de verdade.
GETSONGBPM_API_KEY=
# YouTube Data API v3 (Google Cloud Console — mesmo projeto do login Google, só
# ativar a API e gerar uma chave). Cota gratuita é pequena (~100 buscas/dia), por
# isso é opcional: sem a chave, essa fonte só fica desligada, resto funciona igual.
YOUTUBE_API_KEY=
# TTL do cache de busca de música, em segundos (padrão 3600 = 1h se não definir).
MUSIC_SEARCH_CACHE_TTL=3600
# Timeout por fonte de busca, em ms (padrão 3000 se não definir) — uma fonte lenta
# não trava as outras nem a resposta inteira.
MUSIC_PROVIDER_TIMEOUT=3000
